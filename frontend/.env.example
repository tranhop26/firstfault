# FirstFault browser connection to GenLayer Studionet.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Studionet chain ID.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# Leave empty until deployments/studionet.json contains a verified FirstFault address.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Use v2 only with a verified FirstFault V2 deployment address.
NEXT_PUBLIC_CONTRACT_VERSION=v1
